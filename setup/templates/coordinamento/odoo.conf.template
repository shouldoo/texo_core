[options]
; Generated by setup/coordinamento-up.sh: mode 640, group 101 (the odoo user of the image).
addons_path = /mnt/modules/texo_hub
data_dir = /var/lib/odoo
db_host = db
db_port = 5432
db_user = odoo
db_password = @DB_PASSWORD@
admin_passwd = @ADMIN_PASSWD@
; One database per host name: coord.localhost -> coord.
dbfilter = ^%d$
; the database manager asks for admin_passwd: keep it long, random and known only to the person
list_db = True
proxy_mode = False
; Odoo 20 listens on localhost by default: inside the container it listens on every interface, the host side
; stays on loopback (docker-compose.yml).
http_interface = 0.0.0.0
